# ===== Ubidots MQTT credentials =====
# Token de tu cuenta Ubidots (Industrial). Funciona como username MQTT.
UBIDOTS_TOKEN=BBUS-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Device label en Ubidots (no el nombre, el "label" en minusculas).
UBIDOTS_DEVICE_LABEL=tenebrio-room-01

# Broker MQTT de Ubidots
UBIDOTS_BROKER=industrial.api.ubidots.com

# Puerto MQTT: 1883 plano | 8883 TLS
UBIDOTS_PORT=1883

# Si TRUE -> usa TLS (puerto 8883 recomendado)
UBIDOTS_TLS=false

# ===== Comportamiento del script =====

# Si TRUE -> publica las predicciones de vuelta a Ubidots en variables {var}_pred
PUBLISH_PREDICTIONS=false

# Si TRUE -> al arranque consulta via HTTP las ultimas 30 muestras y precarga
# los buffers para que la primera prediccion salga en el primer MQTT recibido.
PREFILL_FROM_API=true

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Tiempo (segundos) que se espera entre la primera y la ultima lectura del set
# de 6 sensores antes de cerrar y empujar el sample al buffer.
BUCKET_TIMEOUT_SEC=45

# ===== Dashboard (FastAPI) =====
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== Alertas Telegram =====
# Si TRUE -> manda mensajes al chat configurado cuando un sensor cambia
# de estado (ok->abnormal, abnormal->ok) o cuando se predice que se va a
# salir del rango optimo en +3 min. Solo dispara en TRANSICIONES, no en
# cada prediccion, para evitar spam.
#
# Como crear el bot:
#   1. En Telegram, busca @BotFather, manda /newbot y sigue las instrucciones.
#      Te da un token tipo "1234567890:ABC..."
#   2. Crea/abre el chat (privado o grupo) donde quieras recibir alertas.
#      Manda cualquier mensaje al bot primero (requerido por Telegram).
#   3. Para el chat_id privado: busca @userinfobot en Telegram.
#      Para un grupo: agrega @RawDataBot al grupo y mira el "chat":{"id": ...}
#      (suele empezar con "-").
#   4. Pega los valores aqui y pon TELEGRAM_ENABLED=true.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tiempo minimo (segundos) entre mensajes del MISMO sensor para el MISMO
# tipo de alerta. Default 300 (5 min). Evita spam si el valor oscila en
# la frontera del umbral.
TELEGRAM_COOLDOWN_SEC=300

# Si TRUE -> el bot escucha mensajes entrantes y responde via el agente IA
# (requiere AGENT_ENABLED=true y OLLAMA_API_KEY configurado). Default false
# para evitar consumir tokens del LLM sin querer. Se puede activar tambien
# desde el modal de Telegram en el dashboard sin reiniciar.
TELEGRAM_LISTENER_ENABLED=false

# ===== Agente IA conversacional (Ollama Cloud) =====
# Si TRUE, expone POST /api/agent/chat para preguntas en lenguaje natural
# sobre el cuarto. Tambien habilita el escucha bidireccional en Telegram
# (para que el bot responda preguntas, no solo emita alertas).
AGENT_ENABLED=true

# Endpoint de Ollama Cloud (deja por default a menos que uses Ollama local)
OLLAMA_HOST=https://ollama.com

# Modelo a usar. gpt-oss:120b es capaz pero algo lento; granite4.1:8b o
# ministral-3:8b son mas rapidos y baratos. Cambiar aqui no requiere reiniciar
# nada mas que el sidecar.
OLLAMA_MODEL=gpt-oss:120b

# API key de Ollama Cloud. Obtener en https://ollama.com/settings/keys
# Sin este valor el agente queda inactivo (no rompe el resto del sistema).
OLLAMA_API_KEY=
