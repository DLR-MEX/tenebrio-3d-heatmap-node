{
  "name": "tenebrios-node",
  "version": "1.0.0",
  "description": "Visualizacion 3D en tiempo real de temperatura/humedad para cuarto de cria de tenebrios (Node.js + Babylon.js)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "simulator": "node mqttSimulator.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mqtt": "^5.10.0",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
