# Credenciales y configuracion sensible (copiar a .env y ajustar)
UBIDOTS_TOKEN=BBUS-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEVICE_LABEL=tenebrios

# Broker MQTT — por defecto Ubidots industrial
MQTT_BROKER=industrial.api.ubidots.com
MQTT_PORT=1883

# Servidor web
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Nivel de log: error, warn, info, debug
LOG_LEVEL=info
